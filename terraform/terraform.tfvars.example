# Скопіюйте у terraform.tfvars (він у .gitignore) і заповніть.
#   cp terraform.tfvars.example terraform.tfvars

# Префікс OIDC-суб'єкта вашого репозиторію (див. README, «Розгортання», крок 2).
#   репозиторій створено до 15.07.2026:    "repo:OWNER/REPO"
#   репозиторій створено після 15.07.2026: "repo:OWNER@OWNER_ID/REPO@REPO_ID"
github_oidc_subject_prefix = "repo:OWNER@OWNER_ID/REPO@REPO_ID"

# Куди надсилати сповіщення про бюджет.
budget_email = "you@example.com"

# Необов'язково:
# aws_region         = "eu-central-1"
# monthly_budget_usd = 10
# alert_email              = "you@example.com"   # за замовчуванням = budget_email
# autoscaling_max          = 3
# cache_enabled            = true
# enable_scheduled_scaling = false
